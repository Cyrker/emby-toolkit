{
  "fixture_version": 1,
  "scope": "P6.9 native p115 playback HTTP contracts",
  "routes": [
    {"method": "GET", "path": "/api/p115/play/{pick_code}"},
    {"method": "HEAD", "path": "/api/p115/play/{pick_code}"},
    {"method": "GET", "path": "/api/p115/play/{pick_code}/{filename}"},
    {"method": "HEAD", "path": "/api/p115/play/{pick_code}/{filename}"},
    {"method": "GET", "path": "/api/p115/play_pool"},
    {"method": "POST", "path": "/api/p115/play_pool"},
    {"method": "POST", "path": "/api/p115/play_pool/accounts"},
    {"method": "PUT", "path": "/api/p115/play_pool/accounts/{account_id}"},
    {"method": "DELETE", "path": "/api/p115/play_pool/accounts/{account_id}"},
    {"method": "POST", "path": "/api/p115/play_pool/accounts/{account_id}/speedtest"},
    {"method": "POST", "path": "/api/p115/play_pool/cleanup"},
    {"method": "GET", "path": "/api/p115/play_pool/cookie_qrcode"},
    {"method": "GET", "path": "/api/p115/play_pool/cookie_qrcode/status"},
    {"method": "GET", "path": "/api/p115/play_pool/user-account"},
    {"method": "POST", "path": "/api/p115/play_pool/user-account"},
    {"method": "DELETE", "path": "/api/p115/play_pool/user-account"},
    {"method": "GET", "path": "/api/p115/play_pool/user-account/rewards"},
    {"method": "GET", "path": "/api/p115/temp_dir_config"},
    {"method": "POST", "path": "/api/p115/temp_dir_config"}
  ],
  "http_cases": [
    {
      "case_id": "public-direct-play-error",
      "request": {"method": "GET", "path": "/api/p115/play/missing-fixture"},
      "service": {"direct_kind": "error", "status": 404, "body": "fixture direct link not found"},
      "response": {"status": 404, "text": "fixture direct link not found"}
    },
    {
      "case_id": "public-direct-play-redirect",
      "request": {
        "method": "GET",
        "path": "/api/p115/play/fixture-pick/Movie.mkv",
        "headers": {"user-agent": "FixturePlayer/1.0", "range": "bytes=7-19"}
      },
      "service": {
        "direct_kind": "redirect",
        "status": 302,
        "location": "https://media.fixture.invalid/direct/movie"
      },
      "response": {
        "status": 302,
        "headers": {
          "location": "https://media.fixture.invalid/direct/movie",
          "access-control-allow-origin": "*"
        }
      }
    },
    {
      "case_id": "admin-play-pool-read",
      "session": {"emby_user_id": "fixture-admin"},
      "settings": {"auth_enabled": true},
      "request": {"method": "GET", "path": "/api/p115/play_pool"},
      "response": {
        "status": 200,
        "body": {"success": true, "data": {"enabled": true, "usable_count": 1, "accounts": []}}
      }
    },
    {
      "case_id": "admin-denial-precedes-json",
      "settings": {"auth_enabled": true},
      "request": {
        "method": "POST",
        "path": "/api/p115/play_pool/accounts",
        "raw_body": "not-json",
        "headers": {"content-type": "application/json"}
      },
      "response": {
        "status": 403,
        "body": {"status": "error", "message": "需要 Emby 管理员权限才能执行此操作"}
      }
    },
    {
      "case_id": "account-credential-required",
      "session": {"emby_user_id": "fixture-admin"},
      "settings": {"auth_enabled": true},
      "request": {"method": "POST", "path": "/api/p115/play_pool/accounts", "body": {"alias": "Fixture"}},
      "response": {"status": 400, "body": {"success": false, "message": "Cookie/OpenAPI 不能为空"}}
    },
    {
      "case_id": "empty-body-without-json-content-type",
      "session": {"emby_user_id": "fixture-admin"},
      "settings": {"auth_enabled": true},
      "request": {"method": "POST", "path": "/api/p115/play_pool", "raw_body": ""},
      "response": {"status": 415}
    },
    {
      "case_id": "empty-json-body",
      "session": {"emby_user_id": "fixture-admin"},
      "settings": {"auth_enabled": true},
      "request": {
        "method": "POST",
        "path": "/api/p115/play_pool",
        "raw_body": "",
        "headers": {"content-type": "application/json"}
      },
      "response": {"status": 400}
    },
    {
      "case_id": "emby-login-required",
      "request": {"method": "GET", "path": "/api/p115/play_pool/cookie_qrcode"},
      "response": {
        "status": 401,
        "body": {"status": "error", "message": "需要 Emby 用户登录才能访问此资源"}
      }
    },
    {
      "case_id": "empty-session-user-save",
      "session": {"emby_user_id": ""},
      "request": {"method": "POST", "path": "/api/p115/play_pool/user-account", "body": {}},
      "response": {"status": 401, "body": {"success": false, "message": "未登录"}}
    },
    {
      "case_id": "first-user-account-credential-required",
      "session": {"emby_user_id": "fixture-user"},
      "request": {"method": "POST", "path": "/api/p115/play_pool/user-account", "body": {"shared": true}},
      "service": {"user_error": "Cookie/OpenAPI 不能为空"},
      "response": {"status": 400, "body": {"success": false, "message": "Cookie/OpenAPI 不能为空"}}
    },
    {
      "case_id": "temp-config-save-failure",
      "session": {"emby_user_id": "fixture-admin"},
      "settings": {"auth_enabled": true},
      "request": {
        "method": "POST",
        "path": "/api/p115/temp_dir_config",
        "body": {"cleanup_cron": "0 * * * *"}
      },
      "service": {"temp_error": "fixture temp directory unavailable"},
      "response": {
        "status": 500,
        "body": {"success": false, "message": "fixture temp directory unavailable"}
      }
    }
  ]
}
