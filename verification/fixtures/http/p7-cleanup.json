{
  "schema_version": 1,
  "kind": "p7-cleanup-local-http-contract",
  "provenance": {
    "captured_live": false,
    "local_legacy_blueprint_verified": true,
    "sanitized": true,
    "external_validation": "pending",
    "sources": [
      "routes/media_cleanup.py:16-424",
