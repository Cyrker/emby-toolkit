  "golden_master": {
    "inbound_cases": [
      {
        "case_id": "plugin-update-success",
        "request": {"method": "GET", "path": "/api/emby/plugin-update"},
        "response": {
          "status": 200,
          "headers": {
            "cache-control": "no-store",
            "content-disposition": "attachment; filename=\"ETKMediaInfoBridge.dll\"",
            "content-type": "application/octet-stream"
          },
          "body_sha256": "d868bbb63a32fd78c45aa49e272b9f5e79de2e908afd0153f8ec97449ca7fe64"
        }
      },
      {
        "case_id": "metadata-invalid-request",
        "request": {"method": "GET", "path": "/api/emby/metadata"},
        "response": {"status": 400, "body": {"error": "invalid metadata path request"}}
      },
      {
        "case_id": "backfill-all-submitted",
        "request": {"method": "POST", "path": "/api/emby/metadata/backfill"},
        "response": {"status": 202, "body": {"ok": true, "submitted": true}}
      },
      {
        "case_id": "backfill-item-submitted",
        "request": {
          "method": "POST",
          "path": "/api/emby/metadata/backfill/item",
          "body": {"emby_item_id": "item-1"}
        },
        "response": {"status": 202, "body": {"ok": true, "submitted": true, "count": 1}}
      },
      {
        "case_id": "backfill-items-submitted",
        "request": {
          "method": "POST",
          "path": "/api/emby/metadata/backfill/items",
          "body": {"emby_item_ids": ["item-1", "item-1", "item-2"]}
        },
        "response": {"status": 202, "body": {"ok": true, "submitted": true, "count": 1}}
      },
      {
        "case_id": "backfill-library-submitted",
        "request": {
          "method": "POST",
          "path": "/api/emby/metadata/backfill/library",
          "body": {"emby_library_id": "7", "refresh_mode": "missing_metadata"}
        },
        "response": {"status": 202, "body": {"ok": true, "submitted": true, "count": 1}}
      },
      {
        "case_id": "image-search-success",
        "request": {
          "method": "GET",
          "path": "/api/emby/metadata/images/search",
          "query": {"path": "/fixture/movie.mkv", "item_type": "Movie", "include_all_languages": "true"}
        },
        "response": {
          "status": 200,
          "headers": {"cache-control": "no-store"},
          "body": {
            "images": [
              {"type": "Primary", "source_url": "http://fixture.invalid/primary.jpg", "width": 1000}
            ]
          }
        }
      },
      {
        "case_id": "image-refresh-invalid-request",
        "request": {"method": "POST", "path": "/api/emby/metadata/images/refresh"},
        "response": {"status": 400, "body": {"ok": false, "error": "invalid image refresh request"}}
      },
      {
        "case_id": "image-sync-success",
        "request": {
          "method": "POST",
          "path": "/api/emby/metadata/images/sync",
          "query": {"path": "/fixture/movie.mkv", "item_type": "Movie"},
          "body": {"rules": [{"Type": "Primary", "Limit": 1}]}
        },
        "response": {
          "status": 200,
          "headers": {"cache-control": "no-store"},
          "body": {
            "ok": true,
            "images": [
              {
                "type": "Primary",
                "source_url": "http://fixture.invalid/primary.jpg",
                "width": 1000,
                "index": 0
              }
            ]
          }
        }
      },
      {
        "case_id": "unknown-event-compatible-ignore",
        "request": {
          "method": "POST",
          "path": "/api/emby/events",
          "body": {
            "_etk_source": "ETKMediaInfoBridge",
            "Event": "plugin.future-event",
            "EventId": "golden-unknown-event"
          }
        },
        "response": {"status": 200, "body": {"status": "event_ignored_not_in_trigger_list"}}
      }
    ],
    "outbound_cases": [
      {
        "case_id": "configure-origin",
        "request": {
          "method": "POST",
          "path": "/ETKMediaInfo/Origin",
          "query": {"api_key": "<redacted>"},
          "body": {"Url": "http://etk.fixture.invalid"}
        },
        "response_statuses": ["2XX"]
      },
      {
        "case_id": "configure-discovery-url",
        "request": {
          "method": "POST",
          "path": "/ETKMediaInfo/DiscoveryUrl",
          "query": {"api_key": "<redacted>"},
          "body": {"Url": "http://discovery.fixture.invalid"}
        },
        "response_statuses": ["2XX"]
      },
      {
        "case_id": "apply-mediainfo",
        "request": {
          "method": "POST",
          "path": "/Items/item-1/ETKMediaInfo",
          "headers": {"Accept": "application/json", "X-Emby-Token": "<redacted>"},
          "body": {
            "MediaSourceInfo": {"MediaStreams": [{"Type": "Video"}]},
            "Chapters": [{"Name": "Chapter"}],
            "DropConflictingExternalStreams": true
          }
        },
        "response_statuses": ["2XX"]
      },
      {
        "case_id": "apply-intro",
        "request": {
          "method": "POST",
          "path": "/Items/item-2/ETKMediaInfo/Intro",
          "headers": {"Accept": "application/json", "X-Emby-Token": "<redacted>"},
          "body": {"IntroStartTicks": 10, "IntroEndTicks": 20}
        },
        "response_statuses": ["2XX"]
      },
      {
        "case_id": "apply-credits",
        "request": {
          "method": "POST",
          "path": "/Items/item-3/ETKMediaInfo/Credits",
          "headers": {"Accept": "application/json", "X-Emby-Token": "<redacted>"},
          "body": {"CreditsStartTicks": 30}
        },
        "response_statuses": ["2XX"]
      },
      {
        "case_id": "update-chapters",
        "request": {
          "method": "POST",
          "path": "/Items/item-4/ETKMediaInfo/Chapters",
          "headers": {"Accept": "application/json", "X-Emby-Token": "<redacted>"},
          "body": {
            "ClearIntro": false,
            "ClearCredits": true,
            "IntroStartTicks": 40,
            "IntroEndTicks": 50,
            "CreditsStartTicks": 60
          }
        },
        "response_statuses": ["2XX"]
      }
    ]
  },
  "limitations": [
