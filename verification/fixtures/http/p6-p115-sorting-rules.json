  "native_variance_cases": [
    {
      "case_id": "post-mixed-element-array-fails-closed-before-provider-or-save",
      "request": {
        "method": "POST",
        "path": "/api/p115/sorting_rules",
        "body": [{"id": "valid", "cid": "movies"}, 1]
      },
      "account_id": "115001",
      "native_response": {
        "status": 500,
        "body": {
          "status": "error",
          "message": "p115_sorting_rules[1] 必须是对象"
        }
      },
      "native_expected_saved": [],
      "native_expected_provider_calls": [],
      "legacy_unavailable_provider_observation": {
        "status": 200,
        "body": {"status": "success", "message": "115 分类规则已保存"},
        "expected_saved": [{"id": "valid", "cid": "movies"}, 1]
      },
      "variance": "Native intentionally rejects malformed mixed-element arrays before provider or persistence so invalid rule values cannot enter plan revisions."
    }
  ],
  "limitations": [
    "All provider behavior is isolated with local fakes; no real 115 credential or request is used.",
    "The companion account binding is an internal safety precondition and does not change the legacy HTTP envelope.",
    "Malformed mixed-element arrays are an intentional fail-closed variance: Native returns JSON 500 without provider or persistence, while legacy with no client saved the invalid array and returned 200.",
    "Live 115 path semantics and account-switch acceptance remain HUMAN_PENDING."
  ]
}
