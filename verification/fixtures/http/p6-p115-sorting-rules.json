      },
      "stored": [{"id": "old", "cid": "old-dir"}],
      "account_id": "",
      "provider": "unavailable",
      "expected_saved": [],
      "response": {
        "status": 200,
        "body": {"status": "success", "message": "115 分类规则已保存"}
      }
    },
    {
      "case_id": "post-same-cid-reuses-relative-category-path",
      "request": {
        "method": "POST",
