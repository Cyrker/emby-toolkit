        "status": 200,
        "body": {"status": "success", "message": "115 分类规则已保存"}
      }
    },
    {
      "case_id": "post-provider-unavailable-preserves-raw-rule-shape",
      "request": {
        "method": "POST",
        "path": "/api/p115/sorting_rules",
        "body": [{"id": "raw", "cid": "movies", "dir_name": "电影", "custom": true}]
      },
      "stored": [],
      "account_id": "115001",
      "provider": "unavailable",
      "expected_saved": [{"id": "raw", "cid": "movies", "dir_name": "电影", "custom": true}],
      "response": {
        "status": 200,
        "body": {"status": "success", "message": "115 分类规则已保存"}
      }
    },
    {
      "case_id": "post-provider-error-falls-back-to-dir-name",
      "request": {
        "method": "POST",
        "path": "/api/p115/sorting_rules",
        "body": [{"id": "changed", "cid": "new-dir", "dir_name": "新目录"}]
      },
      "stored": [{"id": "changed", "cid": "old-dir", "category_path": "旧目录"}],
      "account_id": "115001",
      "provider": "error",
      "expected_saved": [
        {"id": "changed", "cid": "new-dir", "dir_name": "新目录", "category_path": "新目录"}
