        "body": [{"id": "same", "cid": "movies", "dir_name": "电影", "custom": "kept"}]
      },
      "stored": [{"id": "same", "cid": "movies", "category_path": "媒体库/电影"}],
      "account_id": "115001",
      "provider": "must-not-call",
      "expected_saved": [
        {
          "id": "same",
          "cid": "movies",
          "dir_name": "电影",
          "custom": "kept",
