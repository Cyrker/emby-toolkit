  "cases": [
    {
      "case_id": "list-empty",
      "request": {"method": "GET", "path": "/api/watchlist"},
      "expected": {"status": 200, "body": []}
    },
    {
      "case_id": "add-series",
      "request": {
        "method": "POST",
        "path": "/api/watchlist/add",
        "body": {
          "item_id": "emby-series-fixture",
          "tmdb_id": "100",
          "item_name": "示例剧集",
          "item_type": "Series"
        }
      },
      "expected": {"status": 200, "body": {"message": "《示例剧集》已成功添加到追剧列表！"}}
    },
    {
      "case_id": "status-not-found",
      "request": {
        "method": "POST",
        "path": "/api/watchlist/update_status",
        "body": {"item_id": "missing", "new_status": "Paused"}
      },
      "expected": {"status": 404, "body": {"error": "未在追剧列表中找到该项目"}}
    },
    {
      "case_id": "refresh-accepted",
      "request": {"method": "POST", "path": "/api/watchlist/refresh/100"},
      "expected": {"status": 202, "body": {"message": "《示例剧集》的刷新任务已在后台启动！"}}
    },
    {
      "case_id": "malformed-batch",
      "request": {
        "method": "POST",
        "path": "/api/watchlist/batch_force_end",
        "raw_body": "{",
        "content_type": "application/json"
      },
      "expected": {
        "status": 400,
        "content_type_prefix": "text/html",
        "body_contains": "400 Bad Request"
      }
    },
    {
      "case_id": "update-total",
      "request": {
        "method": "POST",
        "path": "/api/watchlist/update_total_episodes",
        "body": {"tmdb_id": "season-100-1", "total_episodes": 12, "item_type": "Season"}
      },
      "expected": {"status": 200, "body": {"message": "已修正总集数为 12 并锁定。"}}
    },
    {
      "case_id": "settings-default",
      "request": {"method": "GET", "path": "/api/watchlist/settings"},
      "expected": {
        "status": 200,
        "body": {
          "douban_count_correction": false,
          "revival_check_days": 365,
          "tg_channel_tracking": false,
          "intro_detection_trigger_mode": "off",
          "intro_detection_credits_enabled": false,
          "intro_detection_library_ids": []
        }
      }
    }
  ],
  "boundaries": [
    "media_metadata remains P5-owned and is accessed only through an injected projection repository port",
