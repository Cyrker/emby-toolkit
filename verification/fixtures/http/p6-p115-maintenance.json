  "routes": [
    {"method": "GET", "path": "/api/p115/speedtest"},
    {"method": "POST", "path": "/api/p115/mkdir"},
    {"method": "POST", "path": "/api/p115/quick_deploy"},
    {"method": "POST", "path": "/api/p115/recycle_bin/empty"},
    {"method": "GET", "path": "/api/p115/rename_config/mp/import"},
    {"method": "POST", "path": "/api/p115/rename_config/mp/export"},
    {"method": "POST", "path": "/api/p115/unrecognized/empty"}
