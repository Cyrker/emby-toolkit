    {
      "case_id": "partial-file-failure-is-native-fail-closed",
      "auth_enabled": false,
      "request": {
        "method": "POST",
        "path": "/api/p115/replace_strm",
        "json": {
          "mode": "plain",
          "search": "https://old.example.invalid",
