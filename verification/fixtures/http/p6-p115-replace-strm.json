        "files": {
          "Series/one.strm": "https://etk.example.invalid/api/p115/play/replaced-one",
          "Series/two.strm": "https://etk.example.invalid/api/p115/play/replaced-two"
        },
        "library_open_calls": 1,
        "lock_scopes": ["p115-strm-sync:local"]
      }
    },
    {
