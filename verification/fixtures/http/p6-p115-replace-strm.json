{
  "schema_version": 1,
  "kind": "p6-p115-replace-strm-local-http-contract",
  "captured_live": false,
  "route": {"method": "POST", "path": "/api/p115/replace_strm"},
  "cases": [
    {
      "case_id": "admin-denial-precedes-malformed-json",
      "auth_enabled": true,
      "request": {
        "method": "POST",
        "path": "/api/p115/replace_strm",
        "raw_body": "{",
        "content_type": "application/json"
      },
      "library": {
        "available": true,
        "files": {
          "Movies/one.strm": "https://old.example.invalid/api/p115/play/one"
        }
      },
      "expected": {
        "status": 403,
        "json": {
          "status": "error",
          "message": "需要 Emby 管理员权限才能执行此操作"
        },
        "files": {
          "Movies/one.strm": "https://old.example.invalid/api/p115/play/one"
        },
        "library_open_calls": 0,
        "lock_scopes": []
      }
    },
    {
      "case_id": "plain-replacement",
      "auth_enabled": false,
      "request": {
        "method": "POST",
        "path": "/api/p115/replace_strm",
        "json": {
          "mode": "plain",
          "search": "https://old.example.invalid",
          "replace": "https://new.example.invalid"
        }
      },
      "library": {
        "available": true,
        "files": {
          "Movies/one.strm": "https://old.example.invalid/api/p115/play/one",
          "Movies/two.strm": "https://other.example.invalid/api/p115/play/two"
        }
      },
      "expected": {
        "status": 200,
        "json": {
          "success": true,
          "message": "替换完毕！成功修改了 1 个文件 (已跳过 1 个未匹配的文件)"
        },
        "files": {
          "Movies/one.strm": "https://new.example.invalid/api/p115/play/one",
          "Movies/two.strm": "https://other.example.invalid/api/p115/play/two"
        },
        "library_open_calls": 1,
        "lock_scopes": ["p115-strm-sync:local"]
      }
    },
    {
      "case_id": "regex-replacement",
      "auth_enabled": false,
      "request": {
        "method": "POST",
        "path": "/api/p115/replace_strm",
        "json": {
          "mode": "regex",
          "search": "play/(one|two)$",
          "replace": "play/replaced-\\1"
        }
      },
      "library": {
        "available": true,
        "files": {
          "Series/one.strm": "https://etk.example.invalid/api/p115/play/one",
          "Series/two.strm": "https://etk.example.invalid/api/p115/play/two"
