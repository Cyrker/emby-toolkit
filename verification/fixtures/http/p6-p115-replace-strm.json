  ],
  "compatibility_notes": [
    "An unknown mode intentionally preserves the legacy HTTP 200 success/no-op contract and still reports every lowercase .strm file as skipped.",
    "An explicit null replacement preserves the legacy HTTP 200 no-op contract and is never coerced into destructive empty-string replacement.",
    "A per-file failure intentionally differs from legacy: Native fails closed with HTTP 500 even when an earlier file was already changed; no rollback is claimed.",
    "Malformed, missing, and non-object JSON preserve the legacy HTML error transport and must never be normalized into FastAPI 422."
  ],
  "limitations": [
    "All filesystem effects use pytest temporary directories and sanitized fixture URLs.",
    "No real 115, Emby, database, configured media root, or external provider is accessed."
  ]
}
