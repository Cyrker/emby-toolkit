      "library": {
        "available": true,
        "files": {
          "Movies/one.strm": "https://old.example.invalid/api/p115/play/one",
          "Movies/two.strm": "https://old.example.invalid/api/p115/play/two"
        },
        "failure": {
          "after_path": "Movies/one.strm",
          "message": "fixture file write failure"
        }
      },
      "expected": {
        "status": 500,
        "json": {"success": false, "message": "fixture file write failure"},
        "files": {
