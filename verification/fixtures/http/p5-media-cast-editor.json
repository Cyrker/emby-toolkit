        }
      }
    },
    {
      "case_id": "preview-success-malformed-body-is-ignored",
      "request": {
        "method": "POST",
        "path": "/api/preview_processed_cast/fixture-item-1",
        "raw_json": "{"
      },
      "gateway": {
        "ready": true,
        "item_details": true,
        "preview": "fixture"
      },
      "response": {
        "status": 200,
        "body_from": "preview_cast"
      }
    },
    {
      "case_id": "preview-processor-not-ready-precedes-body",
      "request": {
        "method": "POST",
