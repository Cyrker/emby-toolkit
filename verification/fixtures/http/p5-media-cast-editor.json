    {
      "case_id": "update-denial-precedes-readiness-and-body",
      "request": {
        "method": "POST",
        "path": "/api/update_media_cast_sa/fixture-item-1",
        "user": "fixture-user",
        "raw_json": "{"
      },
      "gateway": {
        "ready": false
      },
      "response": {
        "status": 403,
        "body": {
          "status": "error",
          "message": "需要 Emby 管理员权限才能执行此操作"
        }
      }
    },
    {
      "case_id": "update-readiness-precedes-body",
      "request": {
        "method": "POST",
        "path": "/api/update_media_cast_sa/fixture-item-1",
        "user": "fixture-admin",
        "raw_json": "{"
      },
      "gateway": {
        "ready": false
      },
      "response": {
        "status": 503,
        "body": {
          "error": "核心处理器未就绪。"
        }
      }
    },
    {
      "case_id": "translate-success",
      "request": {
        "method": "POST",
        "path": "/api/actions/translate_cast_sa",
        "user": "fixture-admin",
        "json": {
          "cast": [
            {
              "tmdbId": 1001,
              "name": "Fixture Actor",
              "role": "Fixture Role"
            }
          ],
          "title": "Fixture Movie",
          "year": 2026
        }
      },
      "gateway": {
        "ready": true,
        "translation": "fixture"
      },
      "response": {
        "status": 200,
        "body_from": "translated_cast"
      }
    },
    {
      "case_id": "translate-invalid-cast",
      "request": {
        "method": "POST",
        "path": "/api/actions/translate_cast_sa",
        "user": "fixture-admin",
        "json": {
          "cast": "not-a-list"
        }
      },
      "gateway": {
        "ready": true
